# Database & Local Data (CRITICAL: Do not commit personal job data)
data/
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Dependencies & Build Artifacts
frontend/node_modules/
frontend/dist/
backend/bin/
backend/tmp/

# Environment & OS
.env
.DS_Store

# If you prefer the allow list template instead of the deny list, see community template:
